# Copy to .env. Shell launchers load this trusted local file. Never commit the result.
JARVIS_PORT=8787
JARVIS_FRONTEND_PORT=3000
JARVIS_STATE_DIR="$PWD/.runtime"
JARVIS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8787,http://localhost:8787
HERMES_API_URL=http://127.0.0.1:8642
HERMES_HOME="$PWD/hermes/runtime"
OLLAMA_URL=http://127.0.0.1:11434
API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
OPENAI_API_KEY=local-ollama
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
# Launchers require the project hermes/runtime home and discover installed Hermes.
# Optional overrides must be supplied together:
# HERMES_SOURCE=/absolute/path/to/hermes-agent
# HERMES_PYTHON=/absolute/path/to/its/venv/bin/python
# API_SERVER_KEY is loaded server-side from .runtime/hermes.token.
# The native profile uses .runtime/plugin.token for JARVIS_PLUGIN_TOKEN.
# Existing keys may be set in private .env; never put them in VITE_* variables.
JARVIS_TTS_REPO="$PWD/../JarvisLuxTTS"
JARVIS_TTS_PYTHON="$PWD/../JarvisLuxTTS/.venv/bin/python"
JARVIS_TTS_SPEED=0.73
# Initial device only; the CPU/GPU selection in Settings takes precedence once saved.
JARVIS_TTS_DEVICE=cpu
JARVIS_STT_PROVIDER=parakeet
JARVIS_STT_MODEL="$PWD/.runtime/models/parakeet-tdt-0.6b-v3/parakeet-tdt-0.6b-v3.q8_0.gguf"
JARVIS_STT_LIBRARY="$PWD/.runtime/stt/nemo-speech-0.3.0-cpu/lib/libnemo_speech_asr_c.so"
# Empty by default. Applies only to user services; system/root operations are unavailable.
JARVIS_APPROVED_USER_SERVICES=
